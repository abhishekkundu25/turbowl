[package]
name = "turbowl-probe"
version = "0.0.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
turbowl = { path = "@TREE@/crates/turbowl" }
libc = "0.2"

[profile.release]
# As the repository's release profile (its root Cargo.toml), which the bench uses.
lto = "fat"
codegen-units = 1
panic = "unwind"
