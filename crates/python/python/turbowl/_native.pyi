"""Types of the native module (``src/lib.rs``). Use :mod:`turbowl` instead."""

from collections.abc import Iterable, Mapping

from rdflib.term import Node

from turbowl import Triple

__version__: str

_Diagnostic = tuple[str, str, str, tuple[Node, ...]]
"""``(code, severity, message, terms)``."""

_Step = tuple[tuple[Node, Node, Node], str | None, tuple[int, ...]]
"""``((s, p, o), rule, premises)``: ``rule`` is ``None`` for a base triple."""

_Proof = tuple[list[_Step], _Diagnostic | None, str | None, tuple[int, ...], int, str]
"""``(steps, goal, rule, premises, depth, text)``: ``goal`` is ``None`` for a
proof of the last step's statement; ``rule`` and ``premises`` are the goal's."""

class NativeReasoner:
    def __init__(self, switches: Mapping[str, bool] | None = None, complete: bool = False) -> None: ...
    @staticmethod
    def from_snapshot(path: str) -> NativeReasoner: ...
    def save_snapshot(self, path: str) -> None: ...
    def switches(self) -> dict[str, bool]: ...
    def load_file(self, path: str) -> None: ...
    def load_str(self, text: str, format: str, base_iri: str | None = None) -> None: ...
    def insert(self, triples: Iterable[tuple[Node, Node, Node]]) -> None: ...
    def remove(self, triples: Iterable[tuple[Node, Node, Node]]) -> None: ...
    def set_base(self, triples: Iterable[tuple[Node, Node, Node]]) -> bool: ...
    def clear(self) -> None: ...
    def reason(self) -> tuple[int, int, int, int]: ...
    def triples(self) -> list[Triple]: ...
    def inferred(self) -> list[Triple]: ...
    def diagnostics(self) -> list[_Diagnostic]: ...
    def explain(self, s: Node, p: Node, o: Node) -> _Proof | None: ...
    def explain_diagnostic(self, code: str, terms: Iterable[Node]) -> _Proof | None: ...
    def explain_cache_held(self) -> bool:
        """True while the explainer's indexes are kept (for the tests)."""
    def serialize(self, format: str, inferred_only: bool) -> str: ...
    def write(self, path: str, format: str | None, inferred_only: bool) -> None: ...
