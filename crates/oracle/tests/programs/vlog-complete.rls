% Composed by crates/oracle (src/programs.rs) from oracles/rules/: do not edit.
% Groups: core, equality, property-chains, checks, identity, schema, trivial, literal-values.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@source input[3]: load-rdf("input.nt") .

% oracles/rules/core.rls

% The OWL 2 RL rules as Datalog, one file per switch group
% (docs/specs/v2-1-scoreboard-and-rules.md, "The switches"; ADR 0005). This
% file is the always-on core; each other file is named after its switch
% (`turbowl::Switch::name`). crates/oracle (src/programs.rs) composes the
% program for a configuration, this file first and then the file of each
% switch that is on, and emits it for Nemo (the files as they are), Soufflé
% and VLog (translated). The bench's Nemo engine runs the same program.
%
% Each rule is written as the W3C tables (https://www.w3.org/TR/owl2-profiles/
% section 4.3) state it, with its W3C name as the comment that ends it. A
% rule not written yet is listed as `% to come: <name>` in its group's file.
% No owl:Thing typing of subjects, no container-membership axioms (neither
% is an OWL 2 RL rule). Every list (owl:intersectionOf, owl:unionOf,
% owl:propertyChainAxiom) of a class or property is read, including lists
% and list cells derived during the run; a cyclic list, which never reaches
% rdf:nil, matches nothing.
%
% The rules run over generalized triples, as the W3C tables do: a triple with
% a literal subject (prp-rng on a literal object, prp-fp with a literal value)
% is derived and joins like any other, and crates/oracle drops it from the
% closure it reads back, since RDF cannot write it.
%
% Conventions every group file keeps:
% - The prefixes and the input are declared here only.
% - Input: <dir>/input.nt, read into T. crates/oracle encodes every literal
%   and blank node as an IRI first (the rules only compare terms, never
%   values), so an engine never reinterprets a literal (Nemo would normalise
%   "01"^^xsd:integer to 1).
% - Output: <dir>/closure.nt (T) and one CSV per rule that concludes
%   `false`, named after the rule, exported by the group that holds it.
% - A rule whose body has T(?x, ?p, ?y) with a variable predicate reads
%   Tp(?p, ?x, ?y) instead, and its group adds a usedProp rule for the
%   schema triple that binds ?p (see below).
%
% Run by crates/oracle (src/nemo.rs) with nmo from tools/nemo:
%   nmo -o -I <dir> -D <dir> <the composed program>

T(?s, ?p, ?o) :- input(?s, ?p, ?o) .

T(owl:Thing, rdf:type, owl:Class) .  % cls-thing
T(owl:Nothing, rdf:type, owl:Class) .  % cls-nothing1

% Speed, not semantics: a body atom T(?x, ?p, ?y) whose predicate is a
% variable makes Nemo scan all of T when it joins that atom first (99% of the
% time on LUBM). Every rule with such an atom reads Tp(?p, ?x, ?y) instead:
% the triples of T, predicate first, for the properties some schema triple
% names in that position (usedProp). Each rule's ?p is bound by such a
% schema triple, so Tp holds every T triple the rule can match: the rules
% derive exactly what they would with T. The usedProp rules below serve the
% core; each group adds those its own rules need.
usedProp(?p) :- T(?p, rdfs:domain, ?c) .
usedProp(?p) :- T(?p, rdfs:range, ?c) .
usedProp(?p) :- T(?p, rdf:type, owl:FunctionalProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:InverseFunctionalProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:SymmetricProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:TransitiveProperty) .
usedProp(?p) :- T(?p, rdfs:subPropertyOf, ?q) .
usedProp(?p) :- T(?p, owl:equivalentProperty, ?q) .
usedProp(?q) :- T(?p, owl:equivalentProperty, ?q) .
usedProp(?p) :- T(?p, owl:inverseOf, ?q) .
usedProp(?q) :- T(?p, owl:inverseOf, ?q) .
usedProp(?p) :- T(?x, owl:onProperty, ?p) .
Tp(?p, ?x, ?y) :- usedProp(?p), T(?x, ?p, ?y) .

% Table 5: property axioms
T(?x, rdf:type, ?c) :- T(?p, rdfs:domain, ?c), Tp(?p, ?x, ?y) .  % prp-dom
T(?y, rdf:type, ?c) :- T(?p, rdfs:range, ?c), Tp(?p, ?x, ?y) .  % prp-rng
T(?y1, owl:sameAs, ?y2) :- T(?p, rdf:type, owl:FunctionalProperty), Tp(?p, ?x, ?y1), Tp(?p, ?x, ?y2) .  % prp-fp
T(?x1, owl:sameAs, ?x2) :- T(?p, rdf:type, owl:InverseFunctionalProperty), Tp(?p, ?x1, ?y), Tp(?p, ?x2, ?y) .  % prp-ifp
T(?y, ?p, ?x) :- T(?p, rdf:type, owl:SymmetricProperty), Tp(?p, ?x, ?y) .  % prp-symp
T(?x, ?p, ?z) :- T(?p, rdf:type, owl:TransitiveProperty), Tp(?p, ?x, ?y), Tp(?p, ?y, ?z) .  % prp-trp
T(?x, ?p2, ?y) :- T(?p1, rdfs:subPropertyOf, ?p2), Tp(?p1, ?x, ?y) .  % prp-spo1
T(?x, ?p2, ?y) :- T(?p1, owl:equivalentProperty, ?p2), Tp(?p1, ?x, ?y) .  % prp-eqp1
T(?x, ?p1, ?y) :- T(?p1, owl:equivalentProperty, ?p2), Tp(?p2, ?x, ?y) .  % prp-eqp2
T(?y, ?p2, ?x) :- T(?p1, owl:inverseOf, ?p2), Tp(?p1, ?x, ?y) .  % prp-inv1
T(?y, ?p1, ?x) :- T(?p1, owl:inverseOf, ?p2), Tp(?p2, ?x, ?y) .  % prp-inv2

% Lists read from the heads of intersections and unions (asserted or derived).
% rdf:rest stops at rdf:nil: it is never a later cell, whatever triples it
% has, though it can be a head (so every recursion over rdf:rest excludes it).
% member(?h, ?c): ?c is a member of the well-formed list whose head is ?h.
listCell(?h, ?h) :- T(?c, owl:intersectionOf, ?h) .
listCell(?h, ?h) :- T(?c, owl:unionOf, ?h) .
listCell(?h, ?r) :- listCell(?h, ?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil) .
% wellFormed(?l): from cell ?l, every cell has an rdf:first and the rdf:rest
% path reaches rdf:nil (the W3C LIST[...] form).
wellFormed(?l) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil) .
wellFormed(?l) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), wellFormed(?r) .
% memberFrom(?l, ?c): ?c is the rdf:first of ?l or of a later cell, on a
% well-formed path from ?l to rdf:nil.
memberFrom(?l, ?c) :- wellFormed(?l), T(?l, rdf:first, ?c) .
memberFrom(?l, ?c) :- wellFormed(?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), memberFrom(?r, ?c) .
member(?h, ?c) :- listCell(?h, ?h), memberFrom(?h, ?c) .
% allTypes(?l, ?y): ?y has every type from cell ?l to the end of the list.
allTypes(?l, ?y) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil), T(?y, rdf:type, ?c) .
allTypes(?l, ?y) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?y, rdf:type, ?c), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), allTypes(?r, ?y) .

% Table 6: classes
T(?y, rdf:type, ?c) :- T(?c, owl:intersectionOf, ?h), allTypes(?h, ?y) .  % cls-int1
T(?y, rdf:type, ?ci) :- T(?c, owl:intersectionOf, ?h), member(?h, ?ci), T(?y, rdf:type, ?c) .  % cls-int2
T(?y, rdf:type, ?c) :- T(?c, owl:unionOf, ?h), member(?h, ?ci), T(?y, rdf:type, ?ci) .  % cls-uni
T(?u, rdf:type, ?x) :- T(?x, owl:someValuesFrom, ?y), T(?x, owl:onProperty, ?p), Tp(?p, ?u, ?v), T(?v, rdf:type, ?y) .  % cls-svf1
T(?u, rdf:type, ?x) :- T(?x, owl:someValuesFrom, owl:Thing), T(?x, owl:onProperty, ?p), Tp(?p, ?u, ?v) .  % cls-svf2
T(?v, rdf:type, ?y) :- T(?x, owl:allValuesFrom, ?y), T(?x, owl:onProperty, ?p), T(?u, rdf:type, ?x), Tp(?p, ?u, ?v) .  % cls-avf
T(?u, ?p, ?y) :- T(?x, owl:hasValue, ?y), T(?x, owl:onProperty, ?p), T(?u, rdf:type, ?x) .  % cls-hv1
T(?u, rdf:type, ?x) :- T(?x, owl:hasValue, ?y), T(?x, owl:onProperty, ?p), Tp(?p, ?u, ?y) .  % cls-hv2
% to come: cls-oo

% Table 7: class axioms
T(?x, rdf:type, ?c2) :- T(?c1, rdfs:subClassOf, ?c2), T(?x, rdf:type, ?c1) .  % cax-sco
T(?x, rdf:type, ?c2) :- T(?c1, owl:equivalentClass, ?c2), T(?x, rdf:type, ?c1) .  % cax-eqc1
% cax-eqc2 reads the equivalence through equivalentClassOf (?c2 first), so it
% joins as cax-eqc1 and cax-sco do; written with T(?c1, owl:equivalentClass,
% ?c2) first, Nemo took 99% of four minutes on LUBM in this one rule.
equivalentClassOf(?c2, ?c1) :- T(?c1, owl:equivalentClass, ?c2) .
T(?x, rdf:type, ?c1) :- equivalentClassOf(?c2, ?c1), T(?x, rdf:type, ?c2) .  % cax-eqc2

% Table 9: schema vocabulary (the class hierarchy; the rest is the schema group)
T(?c1, rdfs:subClassOf, ?c3) :- T(?c1, rdfs:subClassOf, ?c2), T(?c2, rdfs:subClassOf, ?c3) .  % scm-sco
T(?c1, rdfs:subClassOf, ?c2) :- T(?c1, owl:equivalentClass, ?c2) .  % scm-eqc1
T(?c2, rdfs:subClassOf, ?c1) :- T(?c1, owl:equivalentClass, ?c2) .  % scm-eqc1

% oracles/rules/equality.rls

% The `equality` switch: owl:sameAs makes terms equal (Table 4).

T(?y, owl:sameAs, ?x) :- T(?x, owl:sameAs, ?y) .  % eq-sym
T(?x, owl:sameAs, ?z) :- T(?x, owl:sameAs, ?y), T(?y, owl:sameAs, ?z) .  % eq-trans
T(?s2, ?p, ?o) :- T(?s, owl:sameAs, ?s2), T(?s, ?p, ?o) .  % eq-rep-s
T(?s, ?p2, ?o) :- T(?p, owl:sameAs, ?p2), Tp(?p, ?s, ?o) .  % eq-rep-p
T(?s, ?p, ?o2) :- T(?o, owl:sameAs, ?o2), T(?s, ?p, ?o) .  % eq-rep-o

% eq-rep-p reads Tp: the subject of a sameAs triple is a used property.
usedProp(?p) :- T(?p, owl:sameAs, ?q) .

% oracles/rules/property-chains.rls

% The `property-chains` switch: owl:propertyChainAxiom (Table 5).
%
% prp-spo2: p propertyChainAxiom (p1 ... pn), u0 p1 u1 ... pn un => u0 p un.
% chainCell(?l): a cell of a chain list, reached from an axiom's head.
% chainFrom(?l, ?u, ?w): from ?u, the properties of the cells from ?l to the
% end of the list lead to ?w.
chainCell(?l) :- T(?p, owl:propertyChainAxiom, ?l) .
chainCell(?r) :- chainCell(?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil) .
chainFrom(?l, ?u, ?v) :- chainCell(?l), T(?l, rdf:rest, rdf:nil), T(?l, rdf:first, ?q), Tp(?q, ?u, ?v) .
chainFrom(?l, ?u, ?w) :- chainCell(?l), T(?l, rdf:first, ?q), Tp(?q, ?u, ?v), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), chainFrom(?r, ?v, ?w) .
T(?u, ?p, ?w) :- T(?p, owl:propertyChainAxiom, ?l), chainFrom(?l, ?u, ?w) .  % prp-spo2

% chainFrom reads Tp: the members of a chain are used properties.
usedProp(?q) :- chainCell(?l), T(?l, rdf:first, ?q) .

% oracles/rules/checks.rls

% The `checks` switch: the W3C rules that conclude `false`, and dt-not-type.
% Each rule derives a relation with its terms in the order documented on
% `Finding` (crates/oracle/src/closure.rs), exported to a CSV named after the
% rule.

caxDw(?x, ?c1, ?c2) :- T(?c1, owl:disjointWith, ?c2), T(?x, rdf:type, ?c1), T(?x, rdf:type, ?c2) .  % cax-dw
prpPdw(?p1, ?p2, ?x, ?y) :- T(?p1, owl:propertyDisjointWith, ?p2), Tp(?p1, ?x, ?y), Tp(?p2, ?x, ?y) .  % prp-pdw
clsNothing(?x) :- T(?x, rdf:type, owl:Nothing) .  % cls-nothing2
prpAsyp(?p, ?x, ?y) :- T(?p, rdf:type, owl:AsymmetricProperty), Tp(?p, ?x, ?y), Tp(?p, ?y, ?x) .  % prp-asyp
prpIrp(?p, ?x) :- T(?p, rdf:type, owl:IrreflexiveProperty), Tp(?p, ?x, ?x) .  % prp-irp
clsCom(?c1, ?c2, ?x) :- T(?c1, owl:complementOf, ?c2), T(?x, rdf:type, ?c1), T(?x, rdf:type, ?c2) .  % cls-com

% The lists of owl:AllDifferent, owl:AllDisjointClasses and
% owl:AllDisjointProperties, by position, read as the core reads its lists:
% rdf:rest stops at rdf:nil, a cell is well formed when it has an rdf:first
% and a rest that is rdf:nil or well formed, and the live cells of a head are
% those reached from a well-formed head through well-formed cells (the cells
% on a path to rdf:nil). setAfter(?l, ?m): ?m follows ?l along live cells, one
% rdf:rest or more (in a list that loops through live cells, a cell follows
% itself). setBefore(?h, ?a, ?b): in the list at ?h, ?a is at a position before
% one of ?b.
setList(?h) :- T(?x, owl:members, ?h) .
setList(?h) :- T(?x, owl:distinctMembers, ?h) .
setCell(?h, ?h) :- setList(?h) .
setCell(?h, ?r) :- setCell(?h, ?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil) .
setWellFormed(?l) :- setCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil) .
setWellFormed(?l) :- setCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), setWellFormed(?r) .
setLive(?h, ?h) :- setList(?h), setWellFormed(?h) .
setLive(?h, ?r) :- setLive(?h, ?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), setWellFormed(?r) .
setAfter(?l, ?r) :- setLive(?h, ?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), setWellFormed(?r) .
setAfter(?l, ?m) :- setAfter(?l, ?r), T(?r, rdf:rest, ?m), ~sameTerm(?m, rdf:nil), setWellFormed(?m) .
setBefore(?h, ?a, ?b) :- setLive(?h, ?l), setAfter(?l, ?m), T(?l, rdf:first, ?a), T(?m, rdf:first, ?b) .

eqDiff1(?x, ?y) :- T(?x, owl:sameAs, ?y), T(?x, owl:differentFrom, ?y) .  % eq-diff1
eqDiff2(?x, ?zi, ?zj) :- T(?x, rdf:type, owl:AllDifferent), T(?x, owl:members, ?h), setBefore(?h, ?zi, ?zj), T(?zi, owl:sameAs, ?zj) .  % eq-diff2
eqDiff3(?x, ?zi, ?zj) :- T(?x, rdf:type, owl:AllDifferent), T(?x, owl:distinctMembers, ?h), setBefore(?h, ?zi, ?zj), T(?zi, owl:sameAs, ?zj) .  % eq-diff3
caxAdc(?z, ?ci, ?cj) :- T(?x, rdf:type, owl:AllDisjointClasses), T(?x, owl:members, ?h), setBefore(?h, ?ci, ?cj), T(?z, rdf:type, ?ci), T(?z, rdf:type, ?cj) .  % cax-adc
prpAdp(?pi, ?pj, ?u, ?v) :- T(?x, rdf:type, owl:AllDisjointProperties), T(?x, owl:members, ?h), setBefore(?h, ?pi, ?pj), Tp(?pi, ?u, ?v), Tp(?pj, ?u, ?v) .  % prp-adp
prpNpa1(?i1, ?p, ?i2) :- T(?x, owl:sourceIndividual, ?i1), T(?x, owl:assertionProperty, ?p), T(?x, owl:targetIndividual, ?i2), Tp(?p, ?i1, ?i2) .  % prp-npa1
prpNpa2(?i, ?p, ?lt) :- T(?x, owl:sourceIndividual, ?i), T(?x, owl:assertionProperty, ?p), T(?x, owl:targetValue, ?lt), Tp(?p, ?i, ?lt) .  % prp-npa2

% The cardinality "0"^^xsd:nonNegativeInteger, as crates/oracle names it
% (turbowl_oracle::NAMED_LITERALS).
clsMaxc1(?x, ?u, ?y) :- T(?x, owl:maxCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-0>), T(?x, owl:onProperty, ?p), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y) .  % cls-maxc1
clsMaxqc1(?x, ?u, ?y) :- T(?x, owl:maxQualifiedCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-0>), T(?x, owl:onProperty, ?p), T(?x, owl:onClass, ?c), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y), T(?y, rdf:type, ?c) .  % cls-maxqc1
clsMaxqc2(?x, ?u, ?y) :- T(?x, owl:maxQualifiedCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-0>), T(?x, owl:onProperty, ?p), T(?x, owl:onClass, owl:Thing), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y) .  % cls-maxqc2

% The engines have no datatype checks: literals reach them as opaque IRIs.
% dt-not-type is judged by OWL-RL, the W3C tests and the reference evaluator.
% left out: dt-not-type

% prp-pdw, prp-asyp and prp-irp read Tp.
usedProp(?p) :- T(?p, rdf:type, owl:AsymmetricProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:IrreflexiveProperty) .
usedProp(?p) :- T(?p, owl:propertyDisjointWith, ?q) .
usedProp(?q) :- T(?p, owl:propertyDisjointWith, ?q) .
% prp-adp, prp-npa1 and prp-npa2 read Tp too (the cardinality rules' ?p is
% the core's: owl:onProperty).
usedProp(?p) :- T(?x, rdf:type, owl:AllDisjointProperties), T(?x, owl:members, ?h), setLive(?h, ?l), T(?l, rdf:first, ?p) .
usedProp(?p) :- T(?x, owl:assertionProperty, ?p) .

% oracles/rules/identity.rls

% The `identity` switch: keys and cardinalities that make individuals the
% same (Tables 5 and 6).
%
% The literal "1"^^xsd:nonNegativeInteger that the cardinality rules name
% reaches the engines as the IRI crates/oracle gives it
% (turbowl_oracle::NAMED_LITERALS).

% prp-key: c owl:hasKey (p1 ... pn), x and y of type c, with a common value
% of each pi => x owl:sameAs y. The key list is read as the other lists are
% (core.rls): a path from the head to rdf:nil, each cell giving one first.
% keyCell(?c, ?l): a cell of the key list of class ?c.
% sameKeyFrom(?c, ?l, ?x, ?y): ?x and ?y are of type ?c and share a value of
% the property of each cell from ?l to the end of the list.
keyCell(?c, ?h) :- T(?c, owl:hasKey, ?h) .
keyCell(?c, ?r) :- keyCell(?c, ?l), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil) .
sameKeyFrom(?c, ?l, ?x, ?y) :- keyCell(?c, ?l), T(?l, rdf:rest, rdf:nil), T(?l, rdf:first, ?p), T(?x, rdf:type, ?c), Tp(?p, ?x, ?z), Tp(?p, ?y, ?z), T(?y, rdf:type, ?c) .
sameKeyFrom(?c, ?l, ?x, ?y) :- keyCell(?c, ?l), T(?l, rdf:first, ?p), T(?l, rdf:rest, ?r), ~sameTerm(?r, rdf:nil), sameKeyFrom(?c, ?r, ?x, ?y), Tp(?p, ?x, ?z), Tp(?p, ?y, ?z) .
T(?x, owl:sameAs, ?y) :- T(?c, owl:hasKey, ?h), sameKeyFrom(?c, ?h, ?x, ?y) .  % prp-key

% Table 6: classes
T(?y1, owl:sameAs, ?y2) :- T(?x, owl:maxCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-1>), T(?x, owl:onProperty, ?p), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y1), Tp(?p, ?u, ?y2) .  % cls-maxc2
T(?y1, owl:sameAs, ?y2) :- T(?x, owl:maxQualifiedCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-1>), T(?x, owl:onProperty, ?p), T(?x, owl:onClass, ?c), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y1), T(?y1, rdf:type, ?c), Tp(?p, ?u, ?y2), T(?y2, rdf:type, ?c) .  % cls-maxqc3
T(?y1, owl:sameAs, ?y2) :- T(?x, owl:maxQualifiedCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-1>), T(?x, owl:onProperty, ?p), T(?x, owl:onClass, owl:Thing), T(?u, rdf:type, ?x), Tp(?p, ?u, ?y1), Tp(?p, ?u, ?y2) .  % cls-maxqc4

% sameKeyFrom reads Tp: the properties of a key are used properties (the
% cardinality rules' properties are, by owl:onProperty, in core.rls).
usedProp(?p) :- keyCell(?c, ?l), T(?l, rdf:first, ?p) .

% oracles/rules/schema.rls

% The `schema` switch: the schema rules beyond the class hierarchy (Table 9).
% to come: scm-eqc2, scm-spo, scm-eqp1, scm-eqp2, scm-dom1, scm-dom2, scm-rng1, scm-rng2
% to come: scm-hv, scm-svf1, scm-svf2, scm-avf1, scm-avf2, scm-int, scm-uni

% oracles/rules/trivial.rls

% The `trivial` switch: triples that hold of every term, class, property or
% literal (Tables 4, 5, 8 and 9).
% to come: eq-ref, scm-cls, scm-op, scm-dp, prp-ap, dt-type1, dt-type2

% oracles/rules/literal-values.rls

% The `literal-values` switch: literals compared by value (Table 8).
% to come: dt-eq, dt-diff

% `?x != c` in the source: sameTerm(c, c) for each such constant.
sameTerm(rdf:nil, rdf:nil) .

% The exports, as Rulewerk client commands to issue after `@reason .`:
% @query T(?x1, ?x2, ?x3) EXPORTCSV "closure.csv" .
% @query caxDw(?x1, ?x2, ?x3) EXPORTCSV "cax-dw.csv" .
% @query prpPdw(?x1, ?x2, ?x3, ?x4) EXPORTCSV "prp-pdw.csv" .
% @query clsNothing(?x1) EXPORTCSV "cls-nothing2.csv" .
