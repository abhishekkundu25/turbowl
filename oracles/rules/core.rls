% The OWL 2 RL rules as Datalog, one file per switch group
% (docs/specs/v2-1-scoreboard-and-rules.md, "The switches"; ADR 0005). This
% file is the always-on core; each other file is named after its switch
% (`turbowl::Switch::name`). crates/oracle (src/programs.rs) composes the
% program for a configuration, this file first and then the file of each
% switch that is on, and emits it for Nemo (the files as they are), Soufflé
% and VLog (translated). The bench's Nemo engine runs the same program.
%
% Each rule is written as the W3C tables (https://www.w3.org/TR/owl2-profiles/
% section 4.3) state it, with its W3C name as the comment that ends it. A
% rule not written yet is listed as `% to come: <name>` in its group's file.
% No owl:Thing typing of subjects, no container-membership axioms (neither
% is an OWL 2 RL rule). Every list (owl:intersectionOf, owl:unionOf,
% owl:propertyChainAxiom) of a class or property is read, including lists
% and list cells derived during the run; a cyclic list, which never reaches
% rdf:nil, matches nothing.
%
% The rules run over generalized triples, as the W3C tables do: a triple with
% a literal subject (prp-rng on a literal object, prp-fp with a literal value)
% is derived and joins like any other, and crates/oracle drops it from the
% closure it reads back, since RDF cannot write it.
%
% Conventions every group file keeps:
% - The prefixes and the input are declared here only.
% - Input: <dir>/input.nt, read into T. crates/oracle encodes every literal
%   and blank node as an IRI first (the rules only compare terms, never
%   values), so an engine never reinterprets a literal (Nemo would normalise
%   "01"^^xsd:integer to 1).
% - Output: <dir>/closure.nt (T) and one CSV per rule that concludes
%   `false`, named after the rule, exported by the group that holds it.
% - A rule whose body has T(?x, ?p, ?y) with a variable predicate reads
%   Tp(?p, ?x, ?y) instead, and its group adds a usedProp rule for the
%   schema triple that binds ?p (see below).
%
% Run by crates/oracle (src/nemo.rs) with nmo from tools/nemo:
%   nmo -o -I <dir> -D <dir> <the composed program>

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

@import input :- ntriples{resource="input.nt"} .

T(?s, ?p, ?o) :- input(?s, ?p, ?o) .

T(owl:Thing, rdf:type, owl:Class) .                                                % cls-thing
T(owl:Nothing, rdf:type, owl:Class) .                                              % cls-nothing1

% Speed, not semantics: a body atom T(?x, ?p, ?y) whose predicate is a
% variable makes Nemo scan all of T when it joins that atom first (99% of the
% time on LUBM). Every rule with such an atom reads Tp(?p, ?x, ?y) instead:
% the triples of T, predicate first, for the properties some schema triple
% names in that position (usedProp). Each rule's ?p is bound by such a
% schema triple, so Tp holds every T triple the rule can match: the rules
% derive exactly what they would with T. The usedProp rules below serve the
% core; each group adds those its own rules need.
usedProp(?p) :- T(?p, rdfs:domain, ?c) .
usedProp(?p) :- T(?p, rdfs:range, ?c) .
usedProp(?p) :- T(?p, rdf:type, owl:FunctionalProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:InverseFunctionalProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:SymmetricProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:TransitiveProperty) .
usedProp(?p) :- T(?p, rdfs:subPropertyOf, ?q) .
usedProp(?p) :- T(?p, owl:equivalentProperty, ?q) .
usedProp(?q) :- T(?p, owl:equivalentProperty, ?q) .
usedProp(?p) :- T(?p, owl:inverseOf, ?q) .
usedProp(?q) :- T(?p, owl:inverseOf, ?q) .
usedProp(?p) :- T(?x, owl:onProperty, ?p) .
Tp(?p, ?x, ?y) :- usedProp(?p), T(?x, ?p, ?y) .

% Table 5: property axioms
T(?x, rdf:type, ?c) :- T(?p, rdfs:domain, ?c), Tp(?p, ?x, ?y) .                    % prp-dom
T(?y, rdf:type, ?c) :- T(?p, rdfs:range, ?c), Tp(?p, ?x, ?y) .                     % prp-rng
T(?y1, owl:sameAs, ?y2) :- T(?p, rdf:type, owl:FunctionalProperty),
    Tp(?p, ?x, ?y1), Tp(?p, ?x, ?y2) .                                             % prp-fp
T(?x1, owl:sameAs, ?x2) :- T(?p, rdf:type, owl:InverseFunctionalProperty),
    Tp(?p, ?x1, ?y), Tp(?p, ?x2, ?y) .                                             % prp-ifp
T(?y, ?p, ?x) :- T(?p, rdf:type, owl:SymmetricProperty), Tp(?p, ?x, ?y) .          % prp-symp
T(?x, ?p, ?z) :- T(?p, rdf:type, owl:TransitiveProperty),
    Tp(?p, ?x, ?y), Tp(?p, ?y, ?z) .                                               % prp-trp
T(?x, ?p2, ?y) :- T(?p1, rdfs:subPropertyOf, ?p2), Tp(?p1, ?x, ?y) .               % prp-spo1
T(?x, ?p2, ?y) :- T(?p1, owl:equivalentProperty, ?p2), Tp(?p1, ?x, ?y) .           % prp-eqp1
T(?x, ?p1, ?y) :- T(?p1, owl:equivalentProperty, ?p2), Tp(?p2, ?x, ?y) .           % prp-eqp2
T(?y, ?p2, ?x) :- T(?p1, owl:inverseOf, ?p2), Tp(?p1, ?x, ?y) .                    % prp-inv1
T(?y, ?p1, ?x) :- T(?p1, owl:inverseOf, ?p2), Tp(?p2, ?x, ?y) .                    % prp-inv2

% Lists read from the heads of intersections and unions (asserted or derived).
% rdf:rest stops at rdf:nil: it is never a later cell, whatever triples it
% has, though it can be a head (so every recursion over rdf:rest excludes it).
% member(?h, ?c): ?c is a member of the well-formed list whose head is ?h.
listCell(?h, ?h) :- T(?c, owl:intersectionOf, ?h) .
listCell(?h, ?h) :- T(?c, owl:unionOf, ?h) .
listCell(?h, ?r) :- listCell(?h, ?l), T(?l, rdf:rest, ?r), ?r != rdf:nil .
% wellFormed(?l): from cell ?l, every cell has an rdf:first and the rdf:rest
% path reaches rdf:nil (the W3C LIST[...] form).
wellFormed(?l) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil) .
wellFormed(?l) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, ?r), ?r != rdf:nil, wellFormed(?r) .
% memberFrom(?l, ?c): ?c is the rdf:first of ?l or of a later cell, on a
% well-formed path from ?l to rdf:nil.
memberFrom(?l, ?c) :- wellFormed(?l), T(?l, rdf:first, ?c) .
memberFrom(?l, ?c) :- wellFormed(?l), T(?l, rdf:rest, ?r), ?r != rdf:nil, memberFrom(?r, ?c) .
member(?h, ?c) :- listCell(?h, ?h), memberFrom(?h, ?c) .
% allTypes(?l, ?y): ?y has every type from cell ?l to the end of the list.
allTypes(?l, ?y) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil), T(?y, rdf:type, ?c) .
allTypes(?l, ?y) :- listCell(?h, ?l), T(?l, rdf:first, ?c), T(?y, rdf:type, ?c),
    T(?l, rdf:rest, ?r), ?r != rdf:nil, allTypes(?r, ?y) .

% Table 6: classes
T(?y, rdf:type, ?c) :- T(?c, owl:intersectionOf, ?h), allTypes(?h, ?y) .          % cls-int1
T(?y, rdf:type, ?ci) :- T(?c, owl:intersectionOf, ?h), member(?h, ?ci),
    T(?y, rdf:type, ?c) .                                                          % cls-int2
T(?y, rdf:type, ?c) :- T(?c, owl:unionOf, ?h), member(?h, ?ci),
    T(?y, rdf:type, ?ci) .                                                         % cls-uni
T(?u, rdf:type, ?x) :- T(?x, owl:someValuesFrom, ?y), T(?x, owl:onProperty, ?p),
    Tp(?p, ?u, ?v), T(?v, rdf:type, ?y) .                                          % cls-svf1
T(?u, rdf:type, ?x) :- T(?x, owl:someValuesFrom, owl:Thing), T(?x, owl:onProperty, ?p),
    Tp(?p, ?u, ?v) .                                                               % cls-svf2
T(?v, rdf:type, ?y) :- T(?x, owl:allValuesFrom, ?y), T(?x, owl:onProperty, ?p),
    T(?u, rdf:type, ?x), Tp(?p, ?u, ?v) .                                          % cls-avf
T(?u, ?p, ?y) :- T(?x, owl:hasValue, ?y), T(?x, owl:onProperty, ?p),
    T(?u, rdf:type, ?x) .                                                          % cls-hv1
T(?u, rdf:type, ?x) :- T(?x, owl:hasValue, ?y), T(?x, owl:onProperty, ?p),
    Tp(?p, ?u, ?y) .                                                               % cls-hv2
% to come: cls-oo

% Table 7: class axioms
T(?x, rdf:type, ?c2) :- T(?c1, rdfs:subClassOf, ?c2), T(?x, rdf:type, ?c1) .      % cax-sco
T(?x, rdf:type, ?c2) :- T(?c1, owl:equivalentClass, ?c2), T(?x, rdf:type, ?c1) .   % cax-eqc1
% cax-eqc2 reads the equivalence through equivalentClassOf (?c2 first), so it
% joins as cax-eqc1 and cax-sco do; written with T(?c1, owl:equivalentClass,
% ?c2) first, Nemo took 99% of four minutes on LUBM in this one rule.
equivalentClassOf(?c2, ?c1) :- T(?c1, owl:equivalentClass, ?c2) .
T(?x, rdf:type, ?c1) :- equivalentClassOf(?c2, ?c1), T(?x, rdf:type, ?c2) .        % cax-eqc2

% Table 9: schema vocabulary (the class hierarchy; the rest is the schema group)
T(?c1, rdfs:subClassOf, ?c3) :- T(?c1, rdfs:subClassOf, ?c2), T(?c2, rdfs:subClassOf, ?c3) .  % scm-sco
T(?c1, rdfs:subClassOf, ?c2) :- T(?c1, owl:equivalentClass, ?c2) .                 % scm-eqc1
T(?c2, rdfs:subClassOf, ?c1) :- T(?c1, owl:equivalentClass, ?c2) .                 % scm-eqc1

@export T :- ntriples{resource="closure.nt"} .
