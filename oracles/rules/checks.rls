% The `checks` switch: the W3C rules that conclude `false`, and dt-not-type.
% Each rule derives a relation with its terms in the order documented on
% `Finding` (crates/oracle/src/closure.rs), exported to a CSV named after the
% rule.

caxDw(?x, ?c1, ?c2) :- T(?c1, owl:disjointWith, ?c2), T(?x, rdf:type, ?c1), T(?x, rdf:type, ?c2) .  % cax-dw
prpPdw(?p1, ?p2, ?x, ?y) :- T(?p1, owl:propertyDisjointWith, ?p2), Tp(?p1, ?x, ?y), Tp(?p2, ?x, ?y) .  % prp-pdw
clsNothing(?x) :- T(?x, rdf:type, owl:Nothing) .                                   % cls-nothing2
prpAsyp(?p, ?x, ?y) :- T(?p, rdf:type, owl:AsymmetricProperty), Tp(?p, ?x, ?y), Tp(?p, ?y, ?x) .  % prp-asyp
prpIrp(?p, ?x) :- T(?p, rdf:type, owl:IrreflexiveProperty), Tp(?p, ?x, ?x) .        % prp-irp
clsCom(?c1, ?c2, ?x) :- T(?c1, owl:complementOf, ?c2), T(?x, rdf:type, ?c1), T(?x, rdf:type, ?c2) .  % cls-com

% The lists of owl:AllDifferent, owl:AllDisjointClasses and
% owl:AllDisjointProperties, by position, read as the core reads its lists:
% rdf:rest stops at rdf:nil, a cell is well formed when it has an rdf:first
% and a rest that is rdf:nil or well formed, and the live cells of a head are
% those reached from a well-formed head through well-formed cells (the cells
% on a path to rdf:nil). setAfter(?l, ?m): ?m follows ?l along live cells, one
% rdf:rest or more (in a list that loops through live cells, a cell follows
% itself). setBefore(?h, ?a, ?b): in the list at ?h, ?a is at a position before
% one of ?b.
setList(?h) :- T(?x, owl:members, ?h) .
setList(?h) :- T(?x, owl:distinctMembers, ?h) .
setCell(?h, ?h) :- setList(?h) .
setCell(?h, ?r) :- setCell(?h, ?l), T(?l, rdf:rest, ?r), ?r != rdf:nil .
setWellFormed(?l) :- setCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, rdf:nil) .
setWellFormed(?l) :- setCell(?h, ?l), T(?l, rdf:first, ?c), T(?l, rdf:rest, ?r), ?r != rdf:nil, setWellFormed(?r) .
setLive(?h, ?h) :- setList(?h), setWellFormed(?h) .
setLive(?h, ?r) :- setLive(?h, ?l), T(?l, rdf:rest, ?r), ?r != rdf:nil, setWellFormed(?r) .
setAfter(?l, ?r) :- setLive(?h, ?l), T(?l, rdf:rest, ?r), ?r != rdf:nil, setWellFormed(?r) .
setAfter(?l, ?m) :- setAfter(?l, ?r), T(?r, rdf:rest, ?m), ?m != rdf:nil, setWellFormed(?m) .
setBefore(?h, ?a, ?b) :- setLive(?h, ?l), setAfter(?l, ?m), T(?l, rdf:first, ?a), T(?m, rdf:first, ?b) .

eqDiff1(?x, ?y) :- T(?x, owl:sameAs, ?y), T(?x, owl:differentFrom, ?y) .         % eq-diff1
eqDiff2(?x, ?zi, ?zj) :- T(?x, rdf:type, owl:AllDifferent), T(?x, owl:members, ?h),
    setBefore(?h, ?zi, ?zj), T(?zi, owl:sameAs, ?zj) .                                % eq-diff2
eqDiff3(?x, ?zi, ?zj) :- T(?x, rdf:type, owl:AllDifferent), T(?x, owl:distinctMembers, ?h),
    setBefore(?h, ?zi, ?zj), T(?zi, owl:sameAs, ?zj) .                                % eq-diff3
caxAdc(?z, ?ci, ?cj) :- T(?x, rdf:type, owl:AllDisjointClasses), T(?x, owl:members, ?h),
    setBefore(?h, ?ci, ?cj), T(?z, rdf:type, ?ci), T(?z, rdf:type, ?cj) .             % cax-adc
prpAdp(?pi, ?pj, ?u, ?v) :- T(?x, rdf:type, owl:AllDisjointProperties), T(?x, owl:members, ?h),
    setBefore(?h, ?pi, ?pj), Tp(?pi, ?u, ?v), Tp(?pj, ?u, ?v) .                       % prp-adp
prpNpa1(?i1, ?p, ?i2) :- T(?x, owl:sourceIndividual, ?i1), T(?x, owl:assertionProperty, ?p),
    T(?x, owl:targetIndividual, ?i2), Tp(?p, ?i1, ?i2) .                           % prp-npa1
prpNpa2(?i, ?p, ?lt) :- T(?x, owl:sourceIndividual, ?i), T(?x, owl:assertionProperty, ?p),
    T(?x, owl:targetValue, ?lt), Tp(?p, ?i, ?lt) .                                 % prp-npa2

% The cardinality "0"^^xsd:nonNegativeInteger, as crates/oracle names it
% (turbowl_oracle::NAMED_LITERALS). Each rule reads its restriction's
% instances through a helper relation, as identity.rls does:
% maxZeroOf(?x, ?u, ?p) and maxQZeroOf(?x, ?u, ?p, ?c) for `?u rdf:type ?x`.
maxZeroOf(?x, ?u, ?p) :- T(?x, owl:maxCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-0>),
    T(?x, owl:onProperty, ?p), T(?u, rdf:type, ?x) .
clsMaxc1(?x, ?u, ?y) :- maxZeroOf(?x, ?u, ?p), Tp(?p, ?u, ?y) .                   % cls-maxc1
maxQZero(?x, ?p, ?c) :- T(?x, owl:maxQualifiedCardinality, <urn:x-turbowl-oracle:term:nonNegativeInteger-0>),
    T(?x, owl:onProperty, ?p), T(?x, owl:onClass, ?c) .
maxQZeroOf(?x, ?u, ?p, ?c) :- maxQZero(?x, ?p, ?c), T(?u, rdf:type, ?x) .
clsMaxqc1(?x, ?u, ?y) :- maxQZeroOf(?x, ?u, ?p, ?c), Tp(?p, ?u, ?y), T(?y, rdf:type, ?c) .  % cls-maxqc1
clsMaxqc2(?x, ?u, ?y) :- maxQZeroOf(?x, ?u, ?p, owl:Thing), Tp(?p, ?u, ?y) .       % cls-maxqc2

% The engines have no datatype checks: literals reach them as opaque IRIs.
% dt-not-type is judged by OWL-RL, the W3C tests and the reference evaluator.
% left out: dt-not-type

% prp-pdw, prp-asyp and prp-irp read Tp.
usedProp(?p) :- T(?p, rdf:type, owl:AsymmetricProperty) .
usedProp(?p) :- T(?p, rdf:type, owl:IrreflexiveProperty) .
usedProp(?p) :- T(?p, owl:propertyDisjointWith, ?q) .
usedProp(?q) :- T(?p, owl:propertyDisjointWith, ?q) .
% prp-adp, prp-npa1 and prp-npa2 read Tp too (the cardinality rules' ?p is
% the core's: owl:onProperty).
usedProp(?p) :- T(?x, rdf:type, owl:AllDisjointProperties), T(?x, owl:members, ?h), setLive(?h, ?l), T(?l, rdf:first, ?p) .
usedProp(?p) :- T(?x, owl:assertionProperty, ?p) .

@export caxDw :- csv{resource="cax-dw.csv"} .
@export prpPdw :- csv{resource="prp-pdw.csv"} .
@export clsNothing :- csv{resource="cls-nothing2.csv"} .
@export prpAsyp :- csv{resource="prp-asyp.csv"} .
@export prpIrp :- csv{resource="prp-irp.csv"} .
@export clsCom :- csv{resource="cls-com.csv"} .
@export eqDiff1 :- csv{resource="eq-diff1.csv"} .
@export eqDiff2 :- csv{resource="eq-diff2.csv"} .
@export eqDiff3 :- csv{resource="eq-diff3.csv"} .
@export caxAdc :- csv{resource="cax-adc.csv"} .
@export prpAdp :- csv{resource="prp-adp.csv"} .
@export prpNpa1 :- csv{resource="prp-npa1.csv"} .
@export prpNpa2 :- csv{resource="prp-npa2.csv"} .
@export clsMaxc1 :- csv{resource="cls-maxc1.csv"} .
@export clsMaxqc1 :- csv{resource="cls-maxqc1.csv"} .
@export clsMaxqc2 :- csv{resource="cls-maxqc2.csv"} .
